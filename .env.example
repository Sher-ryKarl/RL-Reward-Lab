# RL-Reward-Lab configuration
# Copy to .env and adjust as needed

# ── Backend ─────────────────────────────────────────────────────────────────────
RL_LAB_PORT=8000
RL_LAB_DEBUG=false
RL_LAB_CORS_ORIGINS=http://localhost,http://127.0.0.1

# ── Auth ─────────────────────────────────────────────────────────────────────────
# Change these in production!
RL_LAB_SECRET_KEY=rl-lab-dev-secret-change-in-production
# Default admin account (auto-created on first startup). Change immediately after first login.
RL_LAB_ADMIN_PASSWORD=admin123

# ── Database ────────────────────────────────────────────────────────────────────
# SQLite (default — single-machine / single-user)
RL_LAB_DATABASE_URL=sqlite+aiosqlite:////app/data/rl_lab.db
# For Postgres: postgresql+asyncpg://user:pass@host:5432/rl_lab

# ── MLflow ──────────────────────────────────────────────────────────────────────
RL_LAB_MLFLOW_TRACKING_URI=sqlite:////app/data/mlflow.db
# For remote tracking: http://mlflow-server:5000

# ── Rate Limiting ────────────────────────────────────────────────────────────────
RL_LAB_RATE_LIMIT=30/minute

# ── RL Training ─────────────────────────────────────────────────────────────────
RL_LAB_DEFAULT_TOTAL_STEPS=50000
RL_LAB_MAX_TOTAL_STEPS=2000000
RL_LAB_MAX_CONCURRENT_RUNS=4
# Set to "cuda" for GPU or "cpu" (auto-detected if unset)
RL_LAB_DEVICE=cpu

# ── Frontend ────────────────────────────────────────────────────────────────────
FRONTEND_PORT=80
